# Deterministic audit works without any external service.
ORGX_ENABLE_OPENAI=0
# Enabling this flag allows the optional UI action to send IR candidates to OpenAI.
OPENAI_API_KEY=
# Set a model snapshot available to your account. No model is silently substituted.
OPENAI_MODEL=
# Optional local SQLite location; default: work/orgx.sqlite
# ORGX_DB=work/orgx.sqlite
